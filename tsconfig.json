{
  "compilerOptions": {
    "module": "Node16",
    "target": "es2022",
    "lib": ["es2022"],
    "noImplicitAny": true,
    "noUnusedLocals": false,
    "noUnusedParameters": true,
    "preserveConstEnums": true,
    "removeComments": true,
    "sourceMap": true,
    "strictNullChecks": true,
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "./dist"
  },
  "include": ["src/**/*.ts", "typings/*.d.ts", "test.ts", "eslint.config.mjs"]
}
